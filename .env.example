# Copy to .env (git and .dockerignore both exclude it) and fill in your own
# values. docker compose and scripts/deploy.sh read .env from the repo root.

# --- Azure OpenAI, used only by the chat page (frontend/chatbot.py) ---------
# Key of your Azure OpenAI resource (Azure portal > Keys and Endpoint)
AZURE_OPENAI_KEY=
# Endpoint of the same resource, e.g. https://<your-resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# ID of an Assistant created in that resource (starts with asst_)
AZURE_ASSISTANT_ID=

# --- Docker Compose ----------------------------------------------------------
# Host port for PostgreSQL, bound to 127.0.0.1. Change it if 5432 is taken.
POSTGRES_HOST_PORT=5432

# --- Set by docker-compose.yml -----------------------------------------------
# Only needed when you run a module outside Docker. Defaults shown.
# Sensor API base URL for the chat page (default http://localhost:8000)
# BACKEND_API_URL=http://localhost:8000
# Kafka bootstrap server for both agents
# KAFKA_BROKER=kafka:9092
# Async SQLAlchemy URL for the data logger
# DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/iotdb
# Sensor API base URL for the occupancy detector
# IOT_API_URL=http://iot-simulation:8000
